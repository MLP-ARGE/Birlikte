<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight ve App Store dağıtımı. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>MG2UZQRTLY</string>

	<!-- Elle imzalama, portaldan oluşturulmuş profille.
	
	     Buraya üç adımda gelindi:
	
	     1. Otomatik imzalama denendi: keychain'de dağıtım sertifikası yokken
	        Xcode Apple'dan bulut yönetimli bir tane istedi ve 403 aldı
	        ("You haven't been given access to cloud-managed distribution
	        certificates"). O sertifikaları ekipte başka biri yönetiyor.
	
	     2. Sertifika CI'a elle taşınıp otomatik imzalamaya dönüldü; çalıştı,
	        ama kullanılan sertifika 26 Eyl 2026'da doldu ve build kırıldı.
	        Aynı profilin içindeki diğer sertifikaların özel anahtarları bu
	        ekipte değildi.
	
	     3. Şimdiki çözüm: hesabın KENDİ "iOS Distribution" sertifikası
	        (2027-09-21) ve portaldan ELLE oluşturulmuş bir App Store profili.
	        Elle imzalama Xcode'un ürettiği profilleri kabul etmiyor
	        ("profile is Xcode managed, but signing settings require a
	        manually managed profile"), bu yüzden profilin elle oluşturulmuş
	        olması şart.
	
	     Kazanç: artık başkasının yönettiği bulut sertifikalarına bağımlı
	     değiliz. Bedel: sertifika 21 Eyl 2027'de dolduğunda IOS_DIST_CERT_P12
	     ve IOS_PROVISION_PROFILE yenilenmeli. -->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>iPhone Distribution</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>com.mlp.birlikte</key>
		<string>Birlikte App Store Manual</string>
	</dict>

	<!-- Yükleme sonrası App Store Connect'te sembolleşmiş kilitlenme
	     raporları için. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Bitcode Xcode 14'ten beri kaldırıldı. -->
	<key>compileBitcode</key>
	<false/>

	<!-- App Store zaten kendi thinning'ini yapıyor. -->
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
