<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight ve App Store dağıtımı. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>MG2UZQRTLY</string>

	<!-- Otomatik imzalama, ama sertifika CI'a elle taşınarak.
	
	     İlk denemede otomatik imzalama şu yüzden düştü: keychain'de dağıtım
	     sertifikası yoktu, Xcode bunun üzerine Apple'dan bulut yönetimli bir
	     tane istedi ve 403 aldı ("You haven't been given access to
	     cloud-managed distribution certificates").
	
	     Elle imzalama (signingStyle: manual) denendi ve o da düştü: Xcode'un
	     ürettiği Store profili "Xcode managed" sayılıyor, elle imzalama ise
	     portaldan elle oluşturulmuş profil istiyor.
	
	     Çözüm ikisinin arası: sertifikayı workflow geçici keychain'e
	     kendimiz yüklüyoruz, profil de Xcode'un ürettiği hâliyle kuruluyor;
	     otomatik imzalama artık ikisini yerelde bulduğu için Apple'a hiç
	     gitmiyor. -allowProvisioningUpdates bilerek verilmiyor, aksi halde
	     yine reddedilen bulut yolunu denerdi. -->
	<key>signingStyle</key>
	<string>automatic</string>

	<!-- Yükleme sonrası App Store Connect'te sembolleşmiş kilitlenme
	     raporları için. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Bitcode Xcode 14'ten beri kaldırıldı. -->
	<key>compileBitcode</key>
	<false/>

	<!-- App Store zaten kendi thinning'ini yapıyor. -->
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
