<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight ve App Store dağıtımı. -->
	<key>method</key>
	<string>app-store-connect</string>

	<key>teamID</key>
	<string>MG2UZQRTLY</string>

	<!-- Elle imzalama. Otomatik imzalama denendi ve Apple dağıtım
	     sertifikası talebini 403 ile reddetti:
	       "You haven't been given access to cloud-managed distribution
	        certificates. Please contact your team's Account Holder or an
	        Admin to give you access."
	     Bu izni yalnızca ekibin Account Holder'ı verebiliyor. İzin gelene
	     kadar sertifikayı CI'a kendimiz taşıyoruz; böylece derleme kimsenin
	     hesap ayarına bağlı kalmıyor.

	     Karşılığı: sertifika süresi dolunca (26 Eyl 2026) IOS_DIST_CERT_P12
	     secret'ının yenilenmesi gerekiyor. -->
	<key>signingStyle</key>
	<string>manual</string>

	<key>signingCertificate</key>
	<string>Apple Distribution</string>

	<key>provisioningProfiles</key>
	<dict>
		<key>com.mlp.birlikte</key>
		<string>iOS Team Store Provisioning Profile: com.mlp.birlikte</string>
	</dict>

	<!-- Yükleme sonrası App Store Connect'te sembolleşmiş kilitlenme
	     raporları için. -->
	<key>uploadSymbols</key>
	<true/>

	<!-- Bitcode Xcode 14'ten beri kaldırıldı. -->
	<key>compileBitcode</key>
	<false/>

	<!-- App Store zaten kendi thinning'ini yapıyor. -->
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
